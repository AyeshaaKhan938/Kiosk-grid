<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Allow exposing files under app cache + external app-specific dirs.
         Used by the kiosk update flow to share the downloaded APK with the
         system installer (PackageInstaller intent). -->
    <cache-path
        name="cache"
        path="." />
    <external-cache-path
        name="external_cache"
        path="." />
    <external-files-path
        name="external_files"
        path="." />
    <files-path
        name="files"
        path="." />
</paths>
