# ─────────────────────────────────────────────
# VMFS USA - Configuración de entorno
# ─────────────────────────────────────────────

# URL base de tu API Laravel en cPanel
# PRODUCCIÓN: cambia este valor a la URL real de tu servidor cPanel
# Ejemplo: https://tudominio.com/api/v1
API_BASE_URL=https://cloud.vmfsusa.com/api/v1

# Número de serie de esta máquina (machine_number en vms-cloud)
MACHINE_NO=866903255700003

# Bearer token de gestión — protege todos los endpoints /admin/*
# Debe coincidir con LOTTERY_MANAGEMENT_API_TOKEN en el .env de vms-cloud
# Si se configura desde el Admin Panel del kiosk, ese valor tiene prioridad.
MANAGEMENT_TOKEN=5f938c58301641d61e730475999acb5204e92ea6d151a176c8b523c72ed7f8be

# Token del grupo de lotería (opcional)
# Solo necesario si se habilita la funcionalidad de sorteos en este kiosk.
LOTTERY_TOKEN=01knvsyjyjadzxrs4ma4k2mabq

# ─────────────────────────────────────────────
# Vending Machine Cloud API (Reyeah)
# ─────────────────────────────────────────────

# URL base del servidor cloud del proveedor
VM_BASE_URL=https://4020y425z1.uicp.fun

# Credenciales que entrega el proveedor (reemplazar con los valores reales)
VM_APP_ID=YOUR_APP_ID_HERE
VM_APP_SECRET=YOUR_APP_SECRET_HERE

# Número de serie de la máquina (machineNo en la API)
VM_MACHINE_NO=YOUR_MACHINE_NO_HERE
