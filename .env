# Número de serie de esta máquina (machine_number en vms-cloud)
MACHINE_NO=866903255700003

# Token del grupo de lotería a consultar
# Este valor identifica qué lottery group se usa en esta máquina
LOTTERY_TOKEN=01knvsyjyjadzxrs4ma4k2mabq

# ─────────────────────────────────────────────
# Vending Machine Cloud API (Reyeah)
# ─────────────────────────────────────────────

# URL base del servidor cloud del proveedor
