# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Per-environment secrets — values are baked into the APK at build time
# via flutter_dotenv. Use .env.example as the template for new clones.
.env
.env.local
.env.*.local

# Local Claude Code permission state — not shared across machines.
.claude/settings.local.json

# Android release-signing material. NEVER commit these — losing the
# keystore means no future APK can update existing installs, and
# leaking it means anyone can ship malicious "updates" to live kiosks.
# Codemagic gets its copy via the Code Signing Identity UI; local
# release builds read android/key.properties.
**/key.properties
*.jks
*.keystore
