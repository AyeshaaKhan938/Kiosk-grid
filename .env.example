# ─────────────────────────────────────────────
# VMFS USA — kiosk environment template
# ─────────────────────────────────────────────
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored and is never committed.
#
# In production, lib/services/app_config.dart bakes a hardcoded
# fallback into the APK for MANAGEMENT_TOKEN / API_BASE_URL / MACHINE_NO,
# so leaving those blank here is fine for client builds.

# vms-cloud (Laravel) backend
API_BASE_URL=https://cloud.vmfsusa.com/api/v1
MACHINE_NO=
MANAGEMENT_TOKEN=
LOTTERY_TOKEN=

# Reyeah Cloud (optional — only used when backend_mode == reyeah)
VM_BASE_URL=https://4020y425z1.uicp.fun
VM_APP_ID=
VM_APP_SECRET=
VM_MACHINE_NO=
