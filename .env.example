# ─────────────────────────────────────────────
# VMFS USA — kiosk environment template
# ─────────────────────────────────────────────
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored and is never committed.
#
# In production, lib/services/app_config.dart bakes a hardcoded
# fallback into the APK for MANAGEMENT_TOKEN / API_BASE_URL / MACHINE_NO,
# so leaving those blank here is fine for client builds.

# vms-cloud (Laravel) backend
API_BASE_URL=https://cloud.vmfsusa.com/api/v1
MACHINE_NO=
MANAGEMENT_TOKEN=
LOTTERY_TOKEN=

# Age verification mobile upload page base (no /api/v1 suffix)
AGE_VERIFICATION_WEB_BASE=https://cloud.vmfsusa.com

# Reyeah Cloud (optional — only used when backend_mode == reyeah)
VM_BASE_URL=https://4020y425z1.uicp.fun
VM_APP_ID=
VM_APP_SECRET=
VM_MACHINE_NO=

# AFEN Open Platform (backend_mode == afen)
AFEN_BASE_URL=
AFEN_APP_ID=
AFEN_APP_SECRET=
AFEN_DEVICE_ID=
AFEN_VMC_URL=
AFEN_MACHINE_ID=
AFEN_SIGN_METHOD=hmac-sha256
AFEN_BEARER_TOKEN=

# TCN serial (backend_mode == tcn — catalog still from vms-cloud)
TCN_SERIAL_BAUD=9600
TCN_BOARD_TYPE=new
TCN_CLEAR_FAULT_CMD=$$$|E|1|%%%
